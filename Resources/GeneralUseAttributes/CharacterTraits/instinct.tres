[resource]
script = ExtResource("1_rixc7")
trait_name = "Instinct"
description = "A high Instinct means you have a keen sense of your surroundings and a natural intuition. You’ll make an Instinct Roll to sense danger, notice details in the world around you, or track an elusive foe."
