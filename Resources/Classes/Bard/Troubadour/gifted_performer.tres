[resource]
script = ExtResource("1_msyn6")
feature_name = "Gifted Performer"
feature_description = "Describe how you perform for others. You can play each song once per long rest:\\n• Relaxing Song: You and all allies within Close range clear a Hit Point.\\n• Epic Song: Make a target within Close range temporarily Vulnerable.\\n• Heartbreaking Song: You and all allies within Close range gain a Hope."
metadata/_custom_type_script = "uid://ckqlyqdo4cyhe"
