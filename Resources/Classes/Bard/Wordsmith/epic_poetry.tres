script = ExtResource("1_5bo1e")
feature_name = "Epic Poetry"
feature_description = "Your Rally Die increases to a d10. Additionally, when you Help an Ally, you can narrate the moment as if you were writing the tale of their heroism in a memoir. When you do, roll a d10 as your advantage die."
