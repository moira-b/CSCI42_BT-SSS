script = ExtResource("1_le7dk")
feature_name = "Elemental Breath"
feature_description = "Choose an element for your breath (such as electricity, fire, or ice). You can use this breath against a target or group of targets within Very Close range, treating it as an Instinct weapon that deals **d8** magic damage using your Proficiency."
